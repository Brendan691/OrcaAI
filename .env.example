# ============================================================
# 小鲸 OrcaAI 环境变量(本地开发默认:零外部服务)
# 复制为 .env 后填入你的 API Key 即可。生产配置见文件末尾。
# ============================================================

# ---- AI 服务(通义千问 / DashScope,必填)----
# 申请:https://help.aliyun.com/zh/model-studio/models  控制台创建 API-KEY
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
CHAT_MODEL=qwen-plus

# ---- 领域包(见 docs/adr/0003)----
ACTIVE_DOMAIN=maritime

# ---- 数据库(本地默认 SQLite,无需安装任何东西)----
DATABASE_URL=sqlite+aiosqlite:///./data/orca.db
DATABASE_URL_SYNC=sqlite:///./data/orca.db

# ---- 文件存储(本地默认:存到 data/files/)----
STORAGE_BACKEND=local

# ---- JWT 认证 ----
JWT_SECRET=change-me-to-a-random-secret-string
JWT_EXPIRE_MINUTES=43200

# ---- 应用 ----
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
ALLOWED_ORIGINS=http://localhost:8501,chrome-extension://*

# ---- 文档处理 ----
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
TOP_K=5

# ---- 混合检索权重(见 docs/adr/0006)----
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.2
TIME_WEIGHT=0.1
TAG_WEIGHT=0.1

# ============================================================
# 生产可选(切换到重型服务栈时才需要,见 docs/adr/0002)
# 需先 pip install -r requirements-prod.txt
# ============================================================
# DATABASE_URL=postgresql+asyncpg://orcaai:orcaai@localhost:5432/orcaai
# STORAGE_BACKEND=minio
# S3_ENDPOINT=localhost:9000
# S3_ACCESS_KEY_ID=orcaaiadmin
# S3_SECRET_ACCESS_KEY=orcaaiadmin
# S3_BUCKET=orcaai-files
# S3_SECURE=false
